# Copy this file to .env and fill in your values

# WebSocket server port
PORT=8765

# Secret token - run `npm run token` to generate one
AUTH_TOKEN=your-secret-token-here

# Maximum concurrent PTY sessions
MAX_SESSIONS=10

# Shell to use (leave empty for system default)
# Linux/Mac: /bin/bash
# Windows: powershell.exe
SHELL_PATH=

# Command to auto-launch after shell opens (e.g. claude)
INITIAL_COMMAND=claude

# TLS (HTTPS/WSS) - set to true for internet access
TLS_ENABLED=false
TLS_CERT_PATH=./certs/cert.pem
TLS_KEY_PATH=./certs/key.pem
